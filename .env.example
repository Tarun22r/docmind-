# Copy this file to .env and fill in only what you need.
# The app works with NONE of these set — it will run in Demo Mode.

# --- Flask -----------------------------------------------------
SECRET_KEY=dev-secret-change-me
FLASK_DEBUG=false

# --- LLM provider -----------------------------------------------------
# One of: openai | gemini | groq | ollama | demo
# If left as "demo" (or the chosen provider has no key), the app
# answers using the local demo/extractive pipeline instead of a real LLM.
LLM_PROVIDER=demo
MODEL_NAME=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=

GROQ_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434

LLM_TIMEOUT_SECONDS=30

# Force demo mode even if a key is configured (useful for testing/demos).
FORCE_DEMO_MODE=false

# --- RAG tuning -----------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.15

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
